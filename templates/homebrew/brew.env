# Homebrew reads this file itself on every run (agents, cron, non-interactive shells).
# Location: $XDG_CONFIG_HOME/homebrew/brew.env if XDG_CONFIG_HOME is set, else ~/.homebrew/brew.env
# Format: KEY=value, no export, no quotes; only HOMEBREW_* lines are read. See playbooks/PB-01.
HOMEBREW_VERIFY_ATTESTATIONS=1
HOMEBREW_CASK_OPTS=--require-sha
HOMEBREW_NO_INSECURE_REDIRECT=1
