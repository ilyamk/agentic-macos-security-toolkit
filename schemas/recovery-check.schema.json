{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/macos-security/recovery-check.schema.json",
  "title": "Backup and sample restore readiness",
  "type": "object",
  "required": ["schema", "record_type", "time_machine", "recorded_drill", "evidence_trust"],
  "properties": {
    "schema": {"const": "macos-security-recovery-check/v1"},
    "record_type": {"const": "recovery_check"},
    "time_machine": {
      "type": "object",
      "required": ["state", "backup_date", "age_days", "assessment_observed_at"],
      "properties": {
        "state": {"enum": ["observed", "unknown"]},
        "backup_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "age_days": {"type": ["integer", "null"]},
        "assessment_observed_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      },
      "additionalProperties": false
    },
    "recorded_drill": {
      "type": ["object", "null"],
      "required": ["checked_at", "sample_matches", "provenance"],
      "properties": {
        "checked_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "sample_matches": {"const": true},
        "provenance": {"const": "owner_selected_files"}
      },
      "additionalProperties": false
    },
    "evidence_trust": {"const": "untrusted_observations"}
  },
  "additionalProperties": false
}
