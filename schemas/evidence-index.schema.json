{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/evidence-index.schema.json",
  "title": "macOS security evidence index",
  "type": "object",
  "required": ["schema", "record_type", "notice", "files"],
  "properties": {
    "schema": { "const": "macos-security-evidence-index/v1" },
    "record_type": { "const": "evidence_index" },
    "notice": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256", "sensitivity", "evidence_trust"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sensitivity": { "enum": ["low", "medium", "high"] },
          "evidence_trust": { "const": "untrusted_observations" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
