{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/macos-security/network-import.schema.json",
  "title": "Normalised outbound network import",
  "type": "object",
  "required": ["schema", "record_type", "source", "collection_coverage", "window", "event_count", "input_count", "out_of_window_count", "correlated_count", "events", "evidence_trust"],
  "properties": {
    "schema": {"const": "macos-security-network-import/v1"},
    "record_type": {"const": "network_import"},
    "source": {"const": "user_supplied_network_observations"},
    "collection_coverage": {"const": "unknown"},
    "window": {
      "type": "object",
      "required": ["from", "to", "first_observed_at", "last_observed_at"],
      "properties": {
        "from": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "to": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "first_observed_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "last_observed_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      },
      "additionalProperties": false
    },
    "event_count": {"type": "integer", "minimum": 0},
    "input_count": {"type": "integer", "minimum": 0},
    "out_of_window_count": {"type": "integer", "minimum": 0},
    "correlated_count": {"type": "integer", "minimum": 0},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["observed_at", "protocol", "decision", "remote_scope", "pid", "process_start_us", "correlation"],
        "properties": {
          "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "protocol": {"enum": ["tcp", "udp"]},
          "decision": {"enum": ["observed", "allowed", "blocked"]},
          "remote_scope": {"enum": ["local", "public", "unknown"]},
          "pid": {"type": ["integer", "null"]},
          "process_start_us": {"type": ["integer", "null"]},
          "correlation": {
            "type": ["object", "null"],
            "required": ["method", "exec_observed_at", "confidence"],
            "properties": {
              "method": {"const": "pid_and_process_start"},
              "exec_observed_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "confidence": {"const": "medium"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_trust": {"const": "untrusted_observations"}
  },
  "additionalProperties": false
}
